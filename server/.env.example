# Server Environment Configuration Example
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vibewall
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Cloudinary Configuration (Optional - Required for persistent image uploads)
# If not configured, VibeWall runs gracefully with text-only posts
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
